# =============================================================================
# Agentic Access Recommendation Engine - example environment configuration
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Agentic Access Recommendation Engine"
ENVIRONMENT=local            # local | dev | staging | production
DEBUG=false
API_PREFIX=/api/v1

# --- Database (PostgreSQL only) ----------------------------------------------
# Either supply the full URL...
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/newjoiner
#
# ...or supply the discrete parts and let the app assemble the URL.
# This is the preferred form for Space-Cloud, where the database host is the
# in-cluster service name of the Space-Cloud PostgreSQL add-on.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=newjoiner
POSTGRES_SSLMODE=prefer      # disable | allow | prefer | require | verify-ca | verify-full

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Governance thresholds (deterministic engine) ----------------------------
# Minimum entitlement affinity (%) for an entitlement to be recommended at all.
AFFINITY_THRESHOLD=70.0
# Peer-matching saturation point used by the peer-confidence formula.
PEER_CONFIDENCE_SATURATION=8
# Minimum number of peers required before peer evidence is considered usable.
MIN_PEER_COUNT=2

# Risk band upper bounds (inclusive). Anything above RISK_HIGH_MAX is CRITICAL.
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=69
RISK_HIGH_MAX=89

# --- SailPoint (simulated) ---------------------------------------------------
SAILPOINT_SOURCE_NAME="Agentic Access Recommendation Engine"
SAILPOINT_REQUEST_TYPE=GrantAccess
# Recommendation statuses eligible for inclusion in the generated request.
SAILPOINT_INCLUDED_STATUSES=AUTO_APPROVED,MANAGER_APPROVAL

# --- LLM abstraction ---------------------------------------------------------
# The LLM writes prose only. It never decides anything: peer selection,
# affinity, risk, policy, SoD, approval tier and the final recommendation
# status are all deterministic, and the explanation service copies those fields
# from the decision rather than from any model output.
#
# LLM_PROVIDER: none | anthropic | openai | google
#   `none`      -> deterministic template explanations (no external dependency)
#   `anthropic` -> requires langchain-anthropic + LLM_API_KEY
#   `openai`    -> requires langchain-openai + LLM_API_KEY
#   `google`    -> requires langchain-google-genai + LLM_API_KEY.
#                  This is the Gemini API, which serves both the Gemini and the
#                  Gemma families from one key; `gemini` is accepted as an alias
#                  for this value. Set the family with LLM_MODEL, e.g.
#                  `gemma-4-31b-it` or `gemini-2.5-pro`.
#
# Gemma models reject the system role, so their prompt is folded into a single
# user turn automatically - no configuration needed.
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
# Bounds the provider SDK's internal retry loop. LLM_TIMEOUT_SECONDS bounds a
# single attempt, not the loop, so without this an overloaded model can hold the
# workflow open past MCP_CLIENT_TIMEOUT_SECONDS.
LLM_MAX_RETRIES=2

# An analysis makes ~5 model calls, so per-call latency multiplies. Prefer a
# fast model: gemini-3.5-flash returns in ~2s where gemma-4-31b-it takes ~31s
# and frequently returns 503/504.

# The /api/v1/chat surface may run on a different model from the explanation
# layer. Chat is one interactive request that must emit valid SQL; explanations
# are ~5 batched prose calls per analysis. On the Gemini API each model has its
# own quota (the free tier allows only 20 requests/day/model), so splitting them
# stops a batch run from starving an interactive question. Falls back to
# LLM_MODEL when unset.
CHAT_LLM_MODEL=

# --- Demo mode ---------------------------------------------------------------
# When true the system runs fully deterministically and never calls an LLM,
# regardless of LLM_PROVIDER. This keeps the governance workflow runnable and
# testable with no external AI dependency.
DEMO_MODE=true

# --- MCP ---------------------------------------------------------------------
MCP_SERVER_NAME=agentic-access-recommendation-engine
# Transport used when running `python -m app.mcp.server`: stdio | http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8081

# How the LangGraph workflow reaches the MCP tools:
#   inmemory -> real MCP client/server session over in-process memory streams
#   stdio    -> real MCP client spawning `python -m app.mcp.server` as subprocess
#   http     -> real MCP client against a running Streamable-HTTP MCP server
#   direct   -> bypass MCP and call domain services in-process (escape hatch)
MCP_CLIENT_MODE=inmemory
MCP_CLIENT_URL=http://localhost:8081/mcp
# With a real LLM the explanation step dominates an analysis (~110s measured),
# so this ceiling has headroom. Deterministic runs finish in under a second.
MCP_CLIENT_TIMEOUT_SECONDS=300

# --- HTTP hardening ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=1048576

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
